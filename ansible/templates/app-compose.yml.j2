services:
  db:
    image: postgres:15-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: tododb
      POSTGRES_USER: todo
      POSTGRES_PASSWORD: ${APP_DB_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U todo -d tododb"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - app

  backend:
    build: ./backend
    restart: unless-stopped
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/tododb
      SPRING_DATASOURCE_USERNAME: todo
      SPRING_DATASOURCE_PASSWORD: ${APP_DB_PASSWORD}
      JAVA_TOOL_OPTIONS: -javaagent:/opt/opentelemetry/opentelemetry-javaagent.jar
      OTEL_SERVICE_NAME: todo-backend
      OTEL_RESOURCE_ATTRIBUTES: deployment.environment=production,service.version=${APP_VERSION:-unknown}
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4318
      OTEL_EXPORTER_OTLP_PROTOCOL: http/protobuf
      OTEL_METRICS_EXPORTER: none
    depends_on:
      db:
        condition: service_healthy
    networks:
      - app
      - proxy

  frontend:
    build: ./frontend
    restart: unless-stopped
    depends_on:
      - backend
    labels:
      - traefik.enable=true
      - traefik.docker.network=examen-proxy
      - traefik.http.routers.todo.rule=Host(`{{ app_domain }}`)
      - traefik.http.routers.todo.entrypoints=web
      - traefik.http.services.todo.loadbalancer.server.port=80
    networks:
      - app
      - proxy

  nginx-exporter:
    image: nginx/nginx-prometheus-exporter:1.4.1
    restart: unless-stopped
    command:
      - --nginx.scrape-uri=http://frontend:8080/stub_status
    depends_on:
      - frontend
    networks:
      - app
      - proxy

networks:
  app:
  proxy:
    external: true
    name: examen-proxy

volumes:
  postgres_data:
